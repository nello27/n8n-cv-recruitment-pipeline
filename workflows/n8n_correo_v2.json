      "parameters": {
        "jsCode": "const item = $input.first();\nconst binaries = item.binary || {};\n\nconst key = Object.keys(binaries).find(k => {\n  const b = binaries[k];\n  const ruta = ((b.directory ? b.directory + '/' : '') + (b.fileName || '')).replace(/\\\\/g, '/');\n  return ruta.endsWith('word/document.xml');\n});\n\nif (!key) {\n  const archivos = Object.entries(binaries).map(([k, b]) => `${k}: ${(b.directory || '')}/${b.fileName}`);\n  throw new Error('No se encontró word/document.xml. Archivos: ' + archivos.join(' | '));\n}\n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, key);\n\nconst texto = buffer.toString('utf8')\n  .replace(/<\\/w:p>/g, '\\n')\n  .replace(/<w:tab\\/>/g, '\\t')\n  .replace(/<w:br\\/>/g, '\\n')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"')\n  .replace(/&apos;/g, \"'\")\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nreturn [{ json: { text: texto } }];"
      },
